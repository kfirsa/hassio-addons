#!/usr/bin/env bash
# Pre-commit: build-test staged add-ons that include Dockerfile / app / rootfs changes.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
if [[ ${#staged[@]} -eq 0 ]]; then
  exit 0
fi

declare -A need=()
for path in "${staged[@]}"; do
  case "${path}" in
    */Dockerfile|*/rootfs/*|*/app/*|*/build.yaml|*/config.yaml)
      addon="${path%%/*}"
      if [[ -f "${ROOT}/${addon}/Dockerfile" ]]; then
        need["${addon}"]=1
      fi
      ;;
  esac
done

if [[ ${#need[@]} -eq 0 ]]; then
  exit 0
fi

addons=("${!need[@]}")
echo "pre-commit: build-testing staged add-on(s): ${addons[*]}"
exec "${ROOT}/scripts/test-addon-build.sh" "${addons[@]}"
